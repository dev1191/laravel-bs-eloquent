includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - src
        - config
    tmpDir: build/phpstan
    ignoreErrors:
        - '#Trait Dev1191\\BikramSambat\\Concerns\\HasBikramSambatScopes is used zero times and is not analysed\.#'
        - '#Called ''env'' outside of the config directory#'
