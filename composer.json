{
    "name": "dev1191/laravel-bs-eloquent",
    "description": "First-class Bikram Sambat (Nepali Date) Eloquent casts, scopes, and validation for Laravel 10 - 13",
    "keywords": [
        "laravel",
        "bikram-sambat",
        "nepali-date",
        "eloquent",
        "nepal"
    ],
    "homepage": "https://github.com/dev1191/laravel-bs-eloquent",
    "license": "MIT",
    "authors": [
        {
            "name": "Dev Raj Thapa",
            "email": "devrajthapa1191@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2 || ^8.3 || ^8.4",
        "spatie/laravel-package-tools": "^1.16",
        "illuminate/contracts": "^10.0 || ^11.0||^12.0||^13.0",
        "illuminate/database": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/validation": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "nesbot/carbon": "^2.62 || ^3.0"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "larastan/larastan": "^2.0 || ^3.0",
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0 || ^11.0.0||^10.0.0||^9.0.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "spatie/laravel-ray": "^1.35"
    },
    "autoload": {
        "psr-4": {
            "Dev1191\\BikramSambat\\": "src/",
            "Dev1191\\BikramSambat\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dev1191\\BikramSambat\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dev1191\\BikramSambat\\BikramSambatServiceProvider"
            ],
            "aliases": {
                "BikramSambat": "Dev1191\\BikramSambat\\Facades\\BikramSambat"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
